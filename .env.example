# Free key at https://helius.dev. Required: Reflect only shows real on-chain data.
HELIUS_API_KEY=
# Optional: enables an LLM-written journal entry (falls back to a template without it).
OPENAI_API_KEY=
# Optional: map FOMO @handles to wallet addresses so they use live data (JSON, single line).
FOMO_HANDLE_MAP=
# Optional: FomoLens key (https://fomolens.app) to resolve FOMO handles to wallets automatically.
FOMOLENS_KEY=
# Optional: transactions scanned per wallet (default 500, max 2000). More history = slower analysis.
HELIUS_MAX_TXS=

# --- Free-plan guards (all optional; defaults shown) ---
# HELIUS_MAX_TXS=2000         # transactions scanned per wallet (100 per Helius call). Raise when you upgrade.
# HELIUS_CONCURRENCY=3        # simultaneous Helius requests per server instance
# DAILY_ANALYSIS_CAP=400      # max real analyses per instance per UTC day, then "at capacity" 
# FOMOLENS_DAILY_CAP=100      # max NEW FomoLens handle lookups per instance per day (~10 credits each)

# Your public URL (used for social link previews)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# $REFLECT holder perks (up to 6 wallets + priority). 
# REFLECT_TOKEN_MINT=2dv5JPuvXMwMyjrkNxRGaw92ZTNufMPFSWQot9Fcpump   # default; only set to override
# REFLECT_MIN_BALANCE=1       # minimum token amount that counts as holding
# HOLDER_RESERVE_CAP=200      # extra daily analyses reserved for holders after the free cap is used up
# DEV_SUPPLY=50000000         # dev-held tokens to burn (shown to holders in the burn roadmap)
